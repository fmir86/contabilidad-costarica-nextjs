# Copy to .env.local and fill in. None of these are needed to build or browse
# the site; they are only used by the contact and newsletter forms.

# SMTP account used by the contact forms (/api/sendEmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=forms@example.com
SMTP_PASS=your-smtp-password
# Where form submissions are delivered (defaults to SMTP_USER)
RECIPIENT_EMAIL=inbox@example.com

# Mailchimp newsletter signup (/api/subscribe). The key ends in "-usXX".
MAILCHIMP_API_KEY=your-mailchimp-key-us1
MAILCHIMP_LIST_ID=your-list-id
